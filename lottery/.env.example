# Gmail adresa, z ktorej sa budú posielať notifikácie
NOTIFY_EMAIL=your_gmail@gmail.com

# Gmail App Password (nie bežné heslo!)
# Vygeneruj na: https://myaccount.google.com/apppasswords
# (Potrebuješ zapnuté 2-faktorové overenie na Gmail účte)
NOTIFY_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Voliteľné: ntfy.sh push notifikácie priamo na telefón
# 1. Nainštaluj aplikáciu ntfy (Android: Play Store / iOS: App Store)
# 2. Zadaj sem unikátny topic (napr. mato-loto-abc123)
# 3. V aplikácii sa prihlásiť (subscribe) na rovnaký topic
NOTIFY_NTFY=
